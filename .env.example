# Remote Browser Rendering Configuration
# Server Port
PORT=3001

# Browser Connection Mode:
# "local"      -> Uses local Chrome / Edge installation directly (zero setup required)
# "docker"     -> Uses local Browserless Docker container (ws://localhost:3000)
# "cloud"      -> Uses remote Browserless.io cloud instance with secure token
BROWSER_MODE=local

# Local Docker Browserless Endpoint (Default ws://localhost:3000)
BROWSERLESS_LOCAL_URL=ws://localhost:3000

# Remote Browserless Cloud Settings (Server-Side Secret - Never expose to client)
BROWSERLESS_WS_ENDPOINT=wss://chrome.browserless.io
BROWSERLESS_API_KEY=your_browserless_api_token_here

# Local Chromium / Edge path (auto-detected if empty)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

